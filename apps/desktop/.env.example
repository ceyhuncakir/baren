# Copy to `.env.local` (git-ignored) and set the server the desktop app talks to.
# Read at build time: `pnpm dev`, `pnpm build` and the `package:*` scripts bake it into the
# app, so every build made from this checkout signs in, syncs and updates against this server.
VITE_SERVER_URL=http://127.0.0.1:8787

# Optional: the auto-update feed (default: <VITE_SERVER_URL>/updates/).
# VITE_UPDATE_URL=https://example.com/updates/
