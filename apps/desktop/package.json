{
  "name": "@baren/desktop",
  "productName": "Baren",
  "version": "0.1.0",
  "private": true,
  "description": "Baren desktop app",
  "author": "baren",
  "homepage": "https://baren.dev",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite build --config vite.web.config.ts && vite preview --config vite.web.config.ts",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "package:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux --publish never",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "test:visual": "playwright test --config playwright.config.ts",
    "smoke": "BAREN_SMOKE=1 electron ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@baren/canvas": "workspace:*",
    "@baren/html": "workspace:*",
    "@baren/schema": "workspace:*",
    "@baren/sync-client": "workspace:*",
    "@baren/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "loro-crdt": "^1.16.4",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
