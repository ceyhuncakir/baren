{
  "name": "@baren/canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Imperative DOM canvas renderer, overlay layer and spatial index.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "sideEffects": false,
  "scripts": {
    "bench": "vite --config bench/vite.config.ts",
    "bench:build": "vite build --config bench/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts --project e2e",
    "test:perf": "playwright test --config playwright.config.ts --project perf",
    "bench:electron": "node bench/run-electron.mjs"
  },
  "dependencies": {
    "@baren/schema": "workspace:*",
    "loro-crdt": "^1.16.4",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "electron": "44.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
