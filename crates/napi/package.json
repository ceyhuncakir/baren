{
  "name": "@baren/core-native",
  "version": "0.1.0",
  "private": true,
  "description": "Node-API bindings to baren-core (Rust) for the Electron main process.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "baren-core",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6"
  }
}
