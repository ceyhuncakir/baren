{
  "name": "baren",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "pnpm --filter @baren/desktop dev",
    "dev:all": "node scripts/dev.mjs",
    "server": "cargo run -p baren-server",
    "build": "pnpm --filter @baren/desktop build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:visual": "pnpm --filter @baren/desktop test:visual",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:native": "pnpm --filter @baren/core-native build",
    "package:linux": "pnpm build:native && pnpm --filter @baren/desktop package:linux",
    "release:linux": "node scripts/release.mjs",
    "release:win": "node scripts/release.mjs --platform win",
    "release:mac": "node scripts/release.mjs --platform mac"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
